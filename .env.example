# -----------------------------------------------------------------------------
# Cloudflare build / generate-supabase-env (required for production)
# Set these in the Cloudflare dashboard as build environment variables.
# Then run BEFORE deploy:  npm run build   (or npm run generate:supabase-env)
# Deploy command stays:    npx wrangler deploy
# -----------------------------------------------------------------------------
SUPABASE_URL=https://gultqhsccxuqvibymwdg.supabase.co
SUPABASE_ANON_KEY=your-publishable-anon-key-here
# Optional Auth redirect base (no trailing slash). Omit to use window.location.origin.
# PULSE_SITE_URL=https://pulseanalyticsgroupllc.com

# Local aliases (optional; generator reads SUPABASE_* above)
VITE_SUPABASE_URL=https://gultqhsccxuqvibymwdg.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Static-site local workflow (alternative to the generator):
# 1. Copy js/supabase-env.example.js → js/supabase-env.js
# 2. Set url + anonKey (publishable only)
# 3. js/supabase-env.js is gitignored — never commit it

# Optional aliases if using Next.js / Vite app later
# NEXT_PUBLIC_SUPABASE_URL=https://gultqhsccxuqvibymwdg.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Auth redirect pages (configure matching URLs in Supabase Dashboard → Authentication → URL Configuration):
# - Site URL (production): https://pulseanalyticsgroupllc.com
# - Redirect URLs must include:
#   http://127.0.0.1:5500/client-update-password.html
#   http://localhost:5500/client-update-password.html
#   https://pulseanalyticsgroupllc.com/client-update-password.html
#   https://pulseanalyticsgroupllc.com/client-login.html

# NEVER put the service-role key in frontend env files, Cloudflare build vars for this script, or Git.
