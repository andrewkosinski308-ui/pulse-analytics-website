# Cloudflare Workers Static Assets ignore list
# Placed at the assets root (repository root). Same syntax as .gitignore.
# Prevents development/build-only files from being uploaded as public assets.

# `.git` is a file in a linked worktree and a directory in a normal checkout.
# A trailing slash matches only the directory, so the worktree file was uploaded.
.git
.github/
.wrangler/
.cursor/
.gitignore
.gitattributes

node_modules/
**/node_modules/**

# Local secrets and env (do not ignore js/supabase-env.js — auth pages load it when present)
.env
.env.*

# Package manager / tooling noise
package-lock.json
npm-debug.log*
yarn.lock
pnpm-lock.yaml

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Temporary / local-only
.tmp-migrations/
.tmp-*
*.log

# Build-time tooling (generated js/supabase-env.js is deployed; the generator is not)
scripts/

# Worker source + Wrangler config (not public assets)
workers/
wrangler.toml
wrangler.json
wrangler.jsonc

# Supabase CLI local state. Do not ship the whole supabase directory:
# only migrations, tests, CLI config, and CLI temp files are local.
supabase/.temp/
supabase/config.toml
supabase/migrations/
supabase/tests/
.supabase/

# Local tests and internal documentation. Runtime JavaScript is not excluded.
*.test.mjs
*.test.js
docs/
src/
README.md
SECURITY.md
package.json
